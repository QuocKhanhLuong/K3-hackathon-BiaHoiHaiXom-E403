# AI Core (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
AI_FAST_REASONING=minimal
AI_GENERATION_REASONING=low
AI_MAX_RETRY_COUNT=2
AI_CONTEXT_MAX_CHARS=12000
AI_RAG_SEMANTIC_ENABLED=true

# Backend
VLEARN_ENVIRONMENT=development
VLEARN_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
VLEARN_SERVE_FRONTEND=true
VLEARN_ANONYMOUS_SESSION_SECRET=replace-with-a-long-random-secret
VLEARN_SESSION_COOKIE_SECURE=false
